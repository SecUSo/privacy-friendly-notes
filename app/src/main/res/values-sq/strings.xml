    <string name="help_intro">Mirë se erdhe në faqen e ndihmës. Ky aplikacion të lejon të marrësh dhe menaxhosh shënime pa kompromentuar privatësinë tënde.</string>
    <string name="help_privacy_heading">Info privatësie</string>
    <string name="help_perm_receive_boot_title">MERR NISJEN E PLOTË</string>
    <string name="help_perm_receive_boot_sum">nevojitet për riplanifikimin e njoftimeve pas rindezjes.</string>
    <string name="help_perm_record_audio_title">REGJISTRO AUDIO</string>
    <string name="help_perm_record_audio_sum">nevojitet për regjistrimin e shënimeve audio; nëse nuk jepet, shënimet audio nuk janë të disponueshme.</string>
    <string name="help_perm_write_external_title">SHKRUAJ NË RUAJTJEN E JASHTME</string>
    <string name="help_perm_write_external_sum">nevojitet për ruajtjen e shënimeve në memorien e brendshme; nëse nuk jepet, shënimet nuk mund të ruhen jashtë.</string>
